        },
        "note": "stub: example text"
      }
    },
    "POST /evidence": {
      "request": "multipart: image",
      "response": {
        "exif": {
          "found": true,
          "fields": {
            "Make": "ExampleMake",
            "Model": "ExampleModel"
          },
          "does_not_prove": "Missing EXIF is weak evidence; present EXIF does not mean real."
        },
        "c2pa": {
          "status": "none",
