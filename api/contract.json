        },
        "ela_png_base64": null,
        "fft_png_base64": null,
        "note": "Evidence, not proof."
      }
    }
  },
  "error_format": {
    "error": "<text>"
  },
  "error_codes": "400 for a bad upload, 500 otherwise"
}
