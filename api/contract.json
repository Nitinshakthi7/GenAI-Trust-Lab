            "params": 900000,
            "size_mb": 4,
            "status": "ready",
            "controls": [
              "seed",
              "n",
              "interpolate"
            ],
            "classes": [],
            "licence_note": "stub: example text"
          }
        ],
        "note": "stub: the real answer lists every generator"
      }
    },
    "POST /generate": {
      "request": {
        "generator_id": "g-vae-fmnist",
        "seed": 42,
        "n": 2,
        "steps": null,
        "guidance": null,
        "class_id": null,
        "interpolate": {
          "seed_b": 7,
          "frames": 2
        }
      },
      "response": {
        "generator_id": "g-vae-fmnist",
        "images": [
          {
            "png_base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAAB...",
            "seed": 42,
            "class_id": null
          },
          {
            "png_base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAAB...",
